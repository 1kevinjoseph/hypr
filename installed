# ─────────────────────────────────────────────
#  hyprlock.conf — Violet Glass Design
#  Resolution: 3840×2160 (4K)
#
#  Font install:
#    yay -S ttf-playfair-display ttf-cormorant-garamond ttf-dm-sans ttf-firacode-nerd
#
#  Layout (all positions are absolute pixels):
#    TOP    — date · clock · sub-label
#    MIDDLE — avatar · username · password input · hint
#    BOTTOM — battery icon · pct · divider · wifi icon
# ─────────────────────────────────────────────

general {
    disable_loading_bar    = true
    hide_cursor            = true
    grace                  = 0
    no_fade_in             = false
    no_fade_out            = false
    ignore_empty_input     = false
    pam_module             = hyprlock
}


# ─── BACKGROUND ───────────────────────────────
background {
    monitor           =
    path              =/home/jupiter/shell-wallpapers/images/v2osk-eKTUtA74uN0-unsplash.jpg
    color             = rgba(10, 12, 20, 1.0)
    blur_passes       = 3
    blur_size         = 8
    noise             = 0.02
    brightness        = 0.85
    vibrancy          = 0.18
    vibrancy_darkness = 0.0
}


# ═══════════════════════════════════════════════
#  TOP — DATE + CLOCK
#  Anchored to top edge (valign=top)
#  Y values count down from the top of the screen
# ═══════════════════════════════════════════════

# Italic date  e.g. "Sunday, 17 May"
label {
    monitor       =
    text          = cmd[update:60000] date +"%-A, %-d %B"
    color         = rgba(200, 200, 230, 0.55)
    font_size     = 42
    font_family   = Cormorant Garamond Light Italic
    position      = 0, -200
    halign        = center
    valign        = top
    shadow_passes = 0
}

# Large clock — Playfair Display Black
label {
    monitor       =
    text          = cmd[update:1000] date +"%H:%M"
    color         = rgba(210, 205, 255, 0.95)
    font_size     = 240
    font_family   = Playfair Display Black
    position      = 0, -150
    halign        = center
    valign        = top
    shadow_passes = 2
    shadow_size   = 16
    shadow_color  = rgba(100, 80, 255, 0.35)
    shadow_boost  = 1.2
}


# ═══════════════════════════════════════════════
#  MIDDLE — AVATAR + AUTH
#  Anchored to screen centre (valign=center)
#  Positive Y moves down, negative Y moves up
# ═══════════════════════════════════════════════

# Avatar — full circle crop
image {
    monitor      =
    path         = /home/jupiter/Documents/backs/pexels-mali-453096.jpg
    size         = 160
    rounding     = -1
    border_size  = 2
    border_color = rgba(130, 110, 255, 0.45)
    position     = 0, 180
    halign       = center
    valign       = center
    shadow_passes = 2
    shadow_size   = 18
    shadow_color  = rgba(100, 80, 255, 0.25)
}

# Username
label {
    monitor       =
    text          = $USER
    color         = rgba(210, 210, 240, 0.70)
    font_size     = 32
    font_family   = DM Sans
    position      = 0, 20
    halign        = center
    valign        = center
    shadow_passes = 0
}

# Password input — pill shape
input-field {
    monitor    =
    size       = 560, 84

    outline_thickness = 2
    dots_size         = 0.25
    dots_spacing      = 0.20
    dots_center       = true
    dots_rounding     = -1

    outer_color  = rgba(150, 130, 255, 0.30)
    inner_color  = rgba(255, 255, 255, 0.06)
    font_color   = rgba(230, 230, 255, 0.90)
    font_size    = 28
    font_family  = DM Sans

    fade_on_empty    = true
    fade_timeout     = 1500
    placeholder_text = <span foreground="##aaa0dc99" font_style="normal">Enter password</span>

    rounding     = 84

    check_color     = rgba(93, 202, 165, 0.85)
    fail_color      = rgba(226, 75, 74, 0.85)
    fail_text       = <i>Authentication failed</i>
    fail_timeout    = 2000
    fail_transition = 300

    position     = 0, -100
    halign       = center
    valign       = center

    shadow_passes = 2
    shadow_size   = 16
    shadow_color  = rgba(100, 80, 255, 0.15)

    capslock_color = rgba(239, 159, 39, 0.85)
}

# Hint
label {
    monitor       =
    text          = press enter to unlock
    color         = rgba(160, 155, 200, 0.28)
    font_size     = 22
    font_family   = DM Sans Light
    position      = 0, -210
    halign        = center
    valign        = center
    shadow_passes = 0
}


# ═══════════════════════════════════════════════
#  BOTTOM — STATUS BAR
#  Anchored to bottom edge (valign=bottom)
#  Y values count up from the bottom of the screen
#  Elements are nudged left/right with X offset
#  to fake a horizontal pill group
# ═══════════════════════════════════════════════

# Battery Nerd Font icon
label {
    monitor       =
    text          = cmd[update:30000] \
        cap=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 0); \
        stat=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo Unknown); \
        if [ "$stat" = "Charging" ]; then echo "󰂄"; \
        elif [ "$cap" -ge 90 ]; then echo "󰁹"; \
        elif [ "$cap" -ge 70 ]; then echo "󰂀"; \
        elif [ "$cap" -ge 50 ]; then echo "󰁾"; \
        elif [ "$cap" -ge 30 ]; then echo "󰁼"; \
        elif [ "$cap" -ge 10 ]; then echo "󰁺"; \
        else echo "󰂃"; fi
    color         = rgba(93, 202, 165, 0.80)
    font_size     = 38
    font_family   = FiraCode Nerd Font
    position      = -160, 100
    halign        = center
    valign        = bottom
    shadow_passes = 0
}

# Battery percentage
label {
    monitor       =
    text          = cmd[update:30000] echo "$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo --)%"
    color         = rgba(190, 190, 230, 0.65)
    font_size     = 30
    font_family   = DM Sans
    position      = -60, 100
    halign        = center
    valign        = bottom
    shadow_passes = 0
}

# Divider dot
label {
    monitor       =
    text          = ·
    color         = rgba(200, 190, 255, 0.22)
    font_size     = 30
    font_family   = DM Sans
    position      = 30, 100
    halign        = center
    valign        = bottom
    shadow_passes = 0
}

# Wi-Fi icon (connected = 󰤨  disconnected = 󰤭)
label {
    monitor       =
    text          = cmd[update:30000] \
        if nmcli -t -f WIFI g | grep -q "enabled"; then \
            if nmcli -t -f ACTIVE,TYPE c | grep -q "^yes:wethernet$"; then echo "󰤨"; \
            elif nmcli -t -f ACTIVE,TYPE c | grep -q "^yes:wifi$"; then echo "󰤨"; \
            else echo "󰤭"; fi; \
        else echo "󰤭"; fi
    color         = rgba(93, 202, 165, 0.80)
    font_size     = 38
    font_family   = FiraCode Nerd Font
    position      = 120, 100
    halign        = center
    valign        = bottom
    shadow_passes = 0
}


# ─────────────────────────────────────────────
#  TUNING GUIDE
#
#  Clock too high/low?
#    Adjust the clock label `position` Y in steps of 20.
#    At 240px font the glyph is ~260px tall; hyprlock measures
#    from the top of the bounding box, not the baseline.
#
#  Avatar missing?
#    Set an absolute path: path = /home/YOU/.config/hypr/avatar.png
#    Any 1:1 PNG works; hyprlock crops to circle automatically.
#
#  No battery (desktop)?
#    Delete the three battery labels and the divider label.
#    Shift the wifi label to position = 0, 100 (centred).
#
#  Wrong battery node?
#    ls /sys/class/power_supply/
#    Replace BAT0 with BAT1 (or whatever shows up) throughout.
#
#  HiDPI / scaling?
#    If you run Hyprland with monitor scale 2, all pixel values
#    here should be doubled — hyprlock works in logical pixels
#    matching your Hyprland monitor scale setting.
# ─────────────────────────────────────────────